{
  "name": "microbeast",
  "productName": "MicroBeast",
  "version": "2.0.0",
  "description": "MicroBeast desktop companion",
  "main": "main.js",
  "author": "Chris Bloor",
  "license": "UNLICENSED",
  "scripts": { "start": "electron .", "dist": "electron-builder --win portable" },
  "devDependencies": { "electron": "31.7.7", "electron-builder": "24.13.3" },
  "build": {
    "appId": "com.microbeast.desktop",
    "productName": "MicroBeast",
    "files": ["main.js", "preload.js", "migrate.html", "icon.png", "tray.png", "app/**"],
    "win": { "target": "portable", "icon": "icon.png" },
    "portable": { "artifactName": "MicroBeast.exe" }
  }
}
